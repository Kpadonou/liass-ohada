# Production frontend build inputs. Prefer LIASS_CDK_OUTPUTS_FILE so API and Cognito
# identifiers come from the deployed prod stack outputs instead of being copied by hand.
LIASS_CDK_OUTPUTS_FILE=../../cdk-outputs.prod.json

# Canonical public and application origins (these defaults are built into the guard).
LIASS_PUBLIC_BASE_URL=https://liassohada.com
LIASS_APP_BASE_URL=https://app.liassohada.com

# Optional explicit overrides for public CDK output values.
LIASS_API_BASE_URL=
LIASS_COGNITO_REGION=
LIASS_COGNITO_USER_POOL_ID=
LIASS_COGNITO_USER_POOL_CLIENT_ID=
LIASS_COGNITO_DOMAIN_URL=
LIASS_COGNITO_REDIRECT_SIGN_IN=https://app.liassohada.com/auth/callback
LIASS_COGNITO_REDIRECT_SIGN_OUT=https://app.liassohada.com/login
LIASS_COGNITO_PROVIDERS=Google,LinkedIn

# Optional public landing-page links.
LIASS_CONTACT_EMAIL=
LIASS_LINKEDIN_URL=
