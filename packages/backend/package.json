{
  "name": "@liass-ohada/backend",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "liass-ohada-backend": "bin/liass-ohada-backend.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "aws:login": "aws sso login --profile rem",
    "aws:whoami": "aws sts get-caller-identity --profile rem",
    "aws:bootstrap": "env -u AWS_PROFILE npx cdk bootstrap aws://570197775998/eu-west-3 --profile rem --cloudformation-execution-policies arn:aws:iam::aws:policy/AdministratorAccess",
    "aws:synth": "env -u AWS_PROFILE npx cdk synth --profile rem",
    "aws:diff": "env -u AWS_PROFILE npx cdk diff --profile rem",
    "cdk:resource-count": "node scripts/count-cdk-resources.cjs",
    "aws:deploy": "env -u AWS_PROFILE npx cdk deploy --all --profile rem",
    "aws:deploy:all": "env -u AWS_PROFILE npx cdk deploy --all --profile rem",
    "backfill:user-workspaces": "ts-node -r tsconfig-paths/register scripts/backfill-user-workspace-index.ts",
    "backfill:product-access": "ts-node -r tsconfig-paths/register scripts/backfill-product-access.ts",
    "cleanup:legacy-product-access": "ts-node -r tsconfig-paths/register scripts/cleanup-legacy-product-access.ts",
    "backfill:accounting-settings": "ts-node -r tsconfig-paths/register scripts/backfill-accounting-settings.ts",
    "repair:cabinet-admin-roles": "ts-node -r tsconfig-paths/register scripts/repair-cabinet-admin-roles.ts",
    "repair:user-profiles": "ts-node -r tsconfig-paths/register scripts/repair-user-profiles.ts",
    "import:syscohada-accounts": "ts-node -r tsconfig-paths/register scripts/import-syscohada-accounts.ts",
    "seed:accounting-test-data": "ts-node -r tsconfig-paths/register scripts/seed-accounting-test-data.ts",
    "seed:manual-lettering-test-data": "ts-node -r tsconfig-paths/register scripts/seed-manual-lettering-test-data.ts",
    "localstack:setup": "AWS_PROFILE=localstack LOCALSTACK_URL=http://localhost:4566 bash scripts/setup-localstack.sh"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@types/aws-lambda": "^8.10.159",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.9",
    "aws-cdk": "^2.1124.1",
    "aws-sdk-client-mock": "^4.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1053.0",
    "@aws-sdk/util-dynamodb": "^3.996.2",
    "@liass-ohada/shared": "file:../shared",
    "aws-cdk-lib": "^2.257.0",
    "axios": "^1.16.1",
    "constructs": "^10.0.0",
    "i18next": "^25.7.3",
    "zod": "^4.3.4"
  }
}
