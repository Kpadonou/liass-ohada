{
  "name": "liass-ohada",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@angular/build": {
      "esbuild": "0.27.7"
    }
  },
  "scripts": {
    "build": "npm run build -w @liass-ohada/shared && npm run build -w @liass-ohada/backend && npm exec --workspace @liass-ohada/frontend -- ng build --progress=false",
    "test": "npm test -w @liass-ohada/backend && npm test -w @liass-ohada/frontend",
    "backend:synth": "npm run aws:synth -w @liass-ohada/backend",
    "backend:deploy": "npm run aws:deploy -w @liass-ohada/backend",
    "frontend:start": "npm run start -w @liass-ohada/frontend"
  }
}
