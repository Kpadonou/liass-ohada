{
  "name": "liass-ohada",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@angular/build": {
      "esbuild": "0.27.7"
    },
    "aws-cdk-lib": {
      "brace-expansion": "5.0.6"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.6"
    },
    "handlebars": "$handlebars",
    "path-to-regexp": "$path-to-regexp"
  },
  "scripts": {
    "build": "npm run build -w @liass-ohada/shared && npm run build -w @liass-ohada/backend && npm run build -w @liass-ohada/frontend",
    "test": "npm test -w @liass-ohada/backend && npm test -w @liass-ohada/frontend",
    "backend:synth": "npm run aws:synth -w @liass-ohada/backend",
    "backend:deploy": "npm run aws:deploy -w @liass-ohada/backend",
    "frontend:start": "rm -rf packages/frontend/.angular/cache && npm run build -w @liass-ohada/shared && npm run start -w @liass-ohada/frontend"
  },
  "devDependencies": {
    "handlebars": "^4.7.9",
    "path-to-regexp": "^8.4.2"
  }
}
